{
  "name": "key-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Key's Electron app and its JavaScript packages",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/key"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "dev": "npm run dev -w @key/electron",
    "build": "npm run build -w @key/electron",
    "start": "npm run build && npm run start -w @key/electron",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:theme-colors": "node tools/check-theme-colors.mjs",
    "notices": "node tools/gen-third-party-notices.mjs",
    "dist:mac": "npm run notices && npm run build && npm run dist:mac -w @key/electron"
  },
  "overrides": {
    "nanoid@3": "^3.3.17",
    "nanoid@5": "^5.1.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "playwright-core": "^1.61.1"
  }
}
