{
  "format": 1,
  "id": "clinicaltrials-gov",
  "version": "1.0.0",
  "minEngine": "1.0.0",
  "name": "ClinicalTrials.gov",
  "description": "The US National Library of Medicine's register of clinical and behavioural studies run around the world.",
  "homepage": "https://clinicaltrials.gov/",
  "category": "registries",
  "coverage": "About 550,000 registered studies from 1999 onwards, in more than 220 countries; drug, device, behavioural and public-health trials and observational studies.",
  "terms": "Free, public-domain US government data, no key. NLM asks for at most about 50 requests per minute; Key waits 1.3 s between requests. Note: clinicaltrials.gov/robots.txt disallows /api/ for web crawlers, but API v2 is NLM's documented route for programmatic access (clinicaltrials.gov/data-api/api); Key uses only that API, at a low rate, for searches a person starts.",
  "kind": "api",
  "credentials": [],
  "hosts": [
    "clinicaltrials.gov"
  ],
  "politeness": {
    "minIntervalMs": 1300,
    "retries": 4,
    "backoffMs": 3000,
    "maxPages": 50
  },
  "options": [
    {
      "id": "itype",
      "label": "Intervention type",
      "default": "",
      "choices": [
        {
          "value": "",
          "label": "Any"
        },
        {
          "value": "BEHAVIORAL",
          "label": "Behavioural"
        },
        {
          "value": "DRUG",
          "label": "Drug"
        },
        {
          "value": "BIOLOGICAL",
          "label": "Biological (vaccines and others)"
        },
        {
          "value": "DEVICE",
          "label": "Device"
        },
        {
          "value": "PROCEDURE",
          "label": "Procedure"
        },
        {
          "value": "DIETARY_SUPPLEMENT",
          "label": "Dietary supplement"
        },
        {
          "value": "OTHER",
          "label": "Other"
        }
      ]
    },
    {
      "id": "stype",
      "label": "Study type",
      "default": "",
      "choices": [
        {
          "value": "",
          "label": "Any"
        },
        {
          "value": "INTERVENTIONAL",
          "label": "Interventional (trials)"
        },
        {
          "value": "OBSERVATIONAL",
          "label": "Observational"
        }
      ]
    }
  ],
  "capabilities": {
    "fields": [
      "all",
      "title",
      "title_abstract",
      "keywords",
      "subject",
      "author",
      "affiliation",
      "identifier"
    ],
    "phrase": true,
    "truncation": false,
    "proximity": false,
    "dates": "day",
    "filters": [],
    "maxResults": 100000,
    "sort": [
      "relevance",
      "date"
    ],
    "exportFields": [
      "title",
      "authors",
      "year",
      "abstract",
      "type",
      "keywords"
    ]
  },
  "query": {
    "mode": "native",
    "fields": {
      "all": "{q}",
      "title": "(AREA[BriefTitle]{q} OR AREA[OfficialTitle]{q} OR AREA[Acronym]{q})",
      "title_abstract": "(AREA[BriefTitle]{q} OR AREA[OfficialTitle]{q} OR AREA[BriefSummary]{q} OR AREA[DetailedDescription]{q})",
      "keywords": "AREA[Keyword]{q}",
      "subject": "(AREA[Condition]{q} OR AREA[ConditionMeshTerm]{q})",
      "author": "AREA[OverallOfficialName]{q}",
      "affiliation": "(AREA[LeadSponsorName]{q} OR AREA[CollaboratorName]{q} OR AREA[OverallOfficialAffiliation]{q})",
      "identifier": "(AREA[NCTId]{q} OR AREA[SecondaryId]{q} OR AREA[OrgStudyId]{q})"
    },
    "fallback": {
      "abstract": "title_abstract",
      "journal": "all",
      "fulltext": "all"
    },
    "defaultField": "all",
    "phrase": "\"{text}\"",
    "words": "{text}",
    "wordJoin": " AND ",
    "perWordField": true,
    "truncate": "{text}",
    "and": " AND ",
    "or": " OR ",
    "not": " NOT ",
    "group": "({q})",
    "notStyle": "andNot",
    "escape": [
      {
        "find": "\"",
        "replace": ""
      },
      {
        "find": "[",
        "replace": " "
      },
      {
        "find": "]",
        "replace": " "
      }
    ],
    "dates": {
      "template": "{q} AND AREA[StartDate]RANGE[{from}, {to}]",
      "from": "{yearFrom}-01-01",
      "to": "{yearTo}-12-31",
      "openFrom": "MIN",
      "openTo": "MAX"
    },
    "maxLength": 6000,
    "chunk": "or-split",
    "maxChunks": 10
  },
  "search": {
    "adapter": "paged",
    "request": {
      "method": "GET",
      "url": "https://clinicaltrials.gov/api/v2/studies",
      "params": {
        "query.term": "{query}",
        "filter.advanced": {
          "join": " AND ",
          "parts": [
            "AREA[InterventionType]{opt.itype?}",
            "AREA[StudyType]{opt.stype?}"
          ]
        },
        "pageSize": "{pageSize}",
        "pageToken": "{token?}",
        "countTotal": "true",
        "format": "json"
      },
      "format": "json"
    },
    "pageSize": 200,
    "paging": {
      "style": "token",
      "next": "$.nextPageToken",
      "stopWhenFewer": true
    },
    "total": "$.totalCount",
    "items": "$.studies[*]",
    "record": {
      "sourceId": "$.protocolSection.identificationModule.nctId",
      "number": "$.protocolSection.identificationModule.nctId",
      "title": {
        "first": [
          "$.protocolSection.identificationModule.officialTitle",
          "$.protocolSection.identificationModule.briefTitle"
        ],
        "type": "text"
      },
      "authors": {
        "path": "$.protocolSection.contactsLocationsModule.overallOfficials[*].name",
        "all": true,
        "name": {
          "literal": "$"
        }
      },
      "year": {
        "first": [
          "$.protocolSection.statusModule.startDateStruct.date",
          "$.protocolSection.statusModule.studyFirstSubmitDate"
        ],
        "type": "year"
      },
      "date": {
        "path": "$.protocolSection.statusModule.studyFirstSubmitDate",
        "type": "date"
      },
      "venue": {
        "path": "$.protocolSection.identificationModule.nctId",
        "template": "ClinicalTrials.gov"
      },
      "publisher": "$.protocolSection.sponsorCollaboratorsModule.leadSponsor.name",
      "abstract": {
        "path": "$.protocolSection.descriptionModule.briefSummary",
        "type": "text"
      },
      "keywords": {
        "path": "$.protocolSection.conditionsModule.keywords[*]",
        "all": true
      },
      "url": {
        "path": "$.protocolSection.identificationModule.nctId",
        "template": "https://clinicaltrials.gov/study/{value}"
      },
      "type": {
        "path": "$.protocolSection.identificationModule.nctId",
        "template": "trial"
      },
      "extras": {
        "fields": {
          "status": "$.protocolSection.statusModule.overallStatus",
          "studyType": "$.protocolSection.designModule.studyType",
          "phase": {
            "path": "$.protocolSection.designModule.phases[*]",
            "all": true,
            "join": ", "
          },
          "conditions": {
            "path": "$.protocolSection.conditionsModule.conditions[*]",
            "all": true,
            "join": "; "
          },
          "interventions": {
            "path": "$.protocolSection.armsInterventionsModule.interventions[*].name",
            "all": true,
            "join": "; "
          },
          "interventionTypes": {
            "path": "$.protocolSection.armsInterventionsModule.interventions[*].type",
            "all": true,
            "join": "; "
          },
          "countries": {
            "path": "$.protocolSection.contactsLocationsModule.locations[*].country",
            "all": true,
            "join": "; "
          },
          "enrollment": "$.protocolSection.designModule.enrollmentInfo.count",
          "allocation": "$.protocolSection.designModule.designInfo.allocation",
          "sponsor": "$.protocolSection.sponsorCollaboratorsModule.leadSponsor.name",
          "completion": "$.protocolSection.statusModule.completionDateStruct.date",
          "hasResults": "$.hasResults"
        }
      }
    }
  },
  "lookup": {
    "adapter": "paged",
    "request": {
      "method": "GET",
      "url": "https://clinicaltrials.gov/api/v2/studies/{id}",
      "params": {
        "format": "json"
      },
      "format": "json"
    },
    "pageSize": 1,
    "paging": {
      "style": "none"
    },
    "items": "$"
  },
  "guide": {
    "summary": "ClinicalTrials.gov is the largest public register of planned, running and finished studies. Searching it finds trials before (or without) a published paper, which helps to spot unpublished results and ongoing work.",
    "coverage": "About 550,000 studies registered since 1999, from all over the world: drug and vaccine trials, behavioural and public-health interventions, and observational studies. Each record is a registration, not a paper.",
    "fields": "Title searches the brief and official titles and the acronym. Title and abstract adds the brief summary and detailed description. Subject searches the conditions studied (with their MeSH terms). Author searches the study's overall officials; affiliation searches the sponsor, collaborators and officials' institutions. Identifier matches NCT numbers and other study ids. The year is the study's start year.",
    "limits": [
      "No wildcards: write out word forms. ClinicalTrials.gov adds synonyms for medical terms by itself.",
      "Results of a registration are rarely linked to the paper that reports them; Key keeps registrations apart from papers when it merges duplicates.",
      "WHO's ICTRP portal holds registrations from other national registries; it has no open API (see the WHO ICTRP connector)."
    ],
    "credentials": "No key needed.",
    "tips": [
      "Use Intervention type = Behavioural for education, messaging, incentive or other non-drug trials.",
      "The record's extras show status, phase, enrolment, countries and whether results are posted."
    ]
  },
  "tests": [
    {
      "name": "malaria-behavioural",
      "query": {
        "concepts": [
          {
            "terms": [
              {
                "text": "malaria",
                "mode": "words",
                "field": "subject"
              }
            ]
          }
        ]
      },
      "options": {
        "itype": "BEHAVIORAL"
      },
      "minTotal": 20,
      "minResults": 10,
      "pages": 1,
      "fields": [
        "title",
        "year",
        "abstract",
        "url"
      ],
      "fixture": "malaria-behavioural",
      "pageSize": 10
    },
    {
      "name": "hand-hygiene-title-dates",
      "query": {
        "concepts": [
          {
            "terms": [
              {
                "text": "hand hygiene",
                "mode": "phrase",
                "field": "title"
              }
            ]
          }
        ],
        "filters": {
          "yearFrom": 2015,
          "yearTo": 2020
        }
      },
      "native": "(AREA[BriefTitle]\"hand hygiene\" OR AREA[OfficialTitle]\"hand hygiene\" OR AREA[Acronym]\"hand hygiene\") AND AREA[StartDate]RANGE[2015-01-01, 2020-12-31]",
      "minTotal": 8,
      "minResults": 10,
      "pages": 1,
      "fields": [
        "title",
        "year",
        "url"
      ],
      "fixture": "hand-hygiene-title-dates",
      "pageSize": 10
    }
  ]
}
